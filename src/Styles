.home-glass {
  --hg-bg: #f3f6f2;
  --hg-surface: rgba(255, 255, 255, 0.76);
  --hg-surface-strong: rgba(255, 255, 255, 0.94);
  --hg-border: rgba(30, 73, 51, 0.11);
  --hg-text: #172b20;
  --hg-muted: #718078;
  --hg-green: #28734c;
  --hg-green-deep: #123d2b;
  --hg-gold: #b99b61;
  --hg-shadow: 0 9px 30px rgba(25, 56, 39, 0.055);

  width: 100%;
  min-width: 0;
  padding-bottom: 28px;
  color: var(--hg-text);
  background:
    radial-gradient(
      circle at 10% 8%,
      rgba(76, 139, 101, 0.08),
      transparent 25rem
    ),
    var(--hg-bg);
}

.dark .home-glass {
  --hg-bg: #0d1913;
  --hg-surface: rgba(24, 42, 32, 0.76);
  --hg-surface-strong: rgba(29, 51, 38, 0.95);
  --hg-border: rgba(190, 220, 199, 0.12);
  --hg-text: #edf4ee;
  --hg-muted: #a2b2a7;
  --hg-green: #82c69b;
  --hg-green-deep: #183c2b;
  --hg-gold: #d7bd85;
  --hg-shadow: 0 12px 35px rgba(0, 0, 0, 0.18);
}

.home-glass *,
.home-glass *::before,
.home-glass *::after {
  box-sizing: border-box;
}